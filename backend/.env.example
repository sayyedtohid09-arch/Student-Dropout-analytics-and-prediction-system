# Leave unset for local SQLite development.
# For Supabase PostgreSQL, use the URI from Supabase Connect settings.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres

# Comma-separated frontend origins are supported.
FRONTEND_URL=http://localhost:5173

# Optional shared secret for write endpoints.
API_KEY=

# Maximum CSV upload size in bytes.
MAX_UPLOAD_SIZE=5242880
